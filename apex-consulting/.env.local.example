# ─────────────────────────────────────────────────────────────────────────────
# Environment variables — copy this file to .env.local and fill in values.
# .env.local is gitignored and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# Your production domain (without https://).
# Used to allow cross-origin access from your live site.
# Leave blank to restrict to localhost only.
NEXT_PUBLIC_DOMAIN=yourcatalystandco.com

# Full public URL of the site (used for og:url, canonical links, etc.)
NEXT_PUBLIC_SITE_URL=https://yourcatalystandco.com
